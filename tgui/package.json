{
	"name": "tgui-workspace",
	"version": "6.0.0",
	"type": "module",
	"devDependencies": {
		"@happy-dom/global-registrator": "^21.0.4",
		"@rspack/cli": "^2.2.9",
		"@rspack/core": "^2.2.9",
		"@testing-library/react": "^16.3.3",
		"@types/bun": "^1.4.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/webpack-env": "^1.18.8",
		"@types/wicg-file-system-access": "^2023.10.7",
		"css-loader": "^7.1.5",
		"sass-embedded": "^1.106.1",
		"sass-loader": "^17.0.1",
		"typescript": "^7.0.2"
	},
	"packageManager": "bun@1.3.3",
	"private": true,
	"scripts": {
		"tgui:analyze": "bun x --bun rspack --analyze",
		"tgui:biome-fix": "bun x --bun biome lint --write .",
		"tgui:build": "bun x --bun rspack build",
		"tgui:dev": "bun --smol packages/tgui-dev-server/index.ts",
		"tgui:test": "bun test",
		"tgui:tsc": "tsc"
	},
	"workspaces": [
		"packages/*"
	]
}
